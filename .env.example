# ── Brand ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=LocalFind
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# ── Neon ───────────────────────────────────────────────────────────────
# Pooled connection (host contains -pooler). The app uses ONLY this one.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Direct connection. drizzle-kit migrations and the seed script use ONLY this one.
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Better Auth ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email / SMS ───────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="LocalFind <no-reply@yourdomain.com>"
ADMIN_EMAIL=admin@yourdomain.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Cloudflare R2 ─────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=localfind-media
# Private bucket for claim / verification documents (defaults to "<R2_BUCKET>-private")
R2_PRIVATE_BUCKET=localfind-private
R2_PUBLIC_URL=https://media.yourdomain.com

# ── Maps / bot protection ────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ── Ops ───────────────────────────────────────────────────────────────
CRON_SECRET=generate-a-long-random-string
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload (CI / Vercel only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
